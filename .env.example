# Copia este fichero a .env (ignorado por git) y rellena los valores.

# Base de datos (laboratorio local; en un servidor, una contraseña propia)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambia-esta-contraseña
# POSTGRES_IMAGE=postgres:17

# Panel del día: base de Odoo y API key del usuario de integración
# (grupos «Usuario interno» + «Panel del día: solo lectura», alcance rpc,
# caducidad máxima 90 días). Nunca la clave de un administrador.
MUEBLES_DB=furniture_db
MUEBLES_ODOO_API_KEY=
# MUEBLES_ODOO_URL=http://127.0.0.1:8070
# MUEBLES_PANEL_HOST=127.0.0.1
