<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Solo lectura de verdad. En Odoo 20 los permisos se suman entre grupos: el usuario
         de integración es «Usuario interno», y ese grupo ya puede escribir en algunos
         modelos (actividades, líneas de movimiento de stock). Un ir.access SIN grupo es
         una restricción global; este solo se activa para el grupo del panel y cierra
         crear, modificar y borrar sin tocar a nadie más. -->
    <record id="restriccion_panel_solo_lectura_product_template" model="ir.access">
        <field name="name">Panel del día: solo lectura en product.template</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="operation">cud</field>
        <field name="domain">[(0, '=', 1)] if user.has_group('ODOO_CRM.group_panel_lectura') else [(1, '=', 1)]</field>
    </record>
