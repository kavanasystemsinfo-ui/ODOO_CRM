# /etc/systemd/system/muebles-jornada.timer
# Tramos de la empresa (hora de Madrid): L-V a las 9, 13 y 17; sábado a las 11.
# Deben coincidir con simulador_plan.TRAMOS.
[Unit]
Description=Tramos de la jornada simulada de Muebles del Hogar

[Timer]
OnCalendar=Mon..Fri *-*-* 09,13,17:05:00 Europe/Madrid
OnCalendar=Sat *-*-* 11:05:00 Europe/Madrid
Persistent=true
Unit=muebles-jornada.service

[Install]
WantedBy=timers.target
