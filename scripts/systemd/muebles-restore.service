# /etc/systemd/system/muebles-restore.service
# Lo lanza muebles-restore.timer cada 30 minutos. Primero comprueba el estado
# (solo lectura) y restaura únicamente si un visitante cambió los datos.
[Unit]
Description=Limpieza condicional del laboratorio de demostración de muebles
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/ODOO_CRM/panel
EnvironmentFile=/etc/muebles/panel.env
Environment=MUEBLES_PANEL_CACHE=/var/cache/muebles-panel
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /root/ODOO_CRM/panel/limpieza_automatica.sh
